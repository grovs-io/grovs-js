{
  "name": "grovs",
  "version": "2.0.0",
  "description": "Grovs generates dynamic links, tracks attributions, and analyzes referrals, seamlessly directing users to your app or the app store for downloads.",
  "type": "module",
  "main": "./dist/grovs.cjs",
  "module": "./dist/grovs.js",
  "types": "./dist/grovs.d.ts",
  "unpkg": "./dist/grovs.global.js",
  "jsdelivr": "./dist/grovs.global.js",
  "exports": {
    ".": {
      "types": "./dist/grovs.d.ts",
      "import": "./dist/grovs.js",
      "require": "./dist/grovs.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && vitest run --coverage",
    "verify": "npm run test && npm run build && node scripts/check-size.mjs && node scripts/check-exports.mjs && playwright test --project=chromium",
    "dev": "tsup --watch",
    "demo": "vite --port 5174 --strictPort",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:live": "playwright test --project=live",
    "test:live:watch": "node scripts/live-watch.mjs"
  },
  "keywords": [
    "grovs",
    "javascript",
    "library",
    "deeplink",
    "attribution"
  ],
  "author": "Grovs",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
