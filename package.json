{
  "name": "grovs",
  "version": "2.0.0",
  "description": "Grovs generates dynamic links, tracks attributions, and analyzes referrals, seamlessly directing users to your app or the app store for downloads.",
  "type": "module",
  "main": "./dist/grovs.cjs",
  "module": "./dist/grovs.js",
  "types": "./dist/grovs.d.ts",
  "unpkg": "./dist/grovs.global.js",
  "jsdelivr": "./dist/grovs.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/grovs.d.ts",
        "default": "./dist/grovs.js"
      },
      "require": {
        "types": "./dist/grovs.d.cts",
        "default": "./dist/grovs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && vitest run --coverage",
    "verify": "npm run test && npm run build && node scripts/check-size.mjs && node scripts/check-exports.mjs && npm run test:e2e:browsers",
    "test:e2e:browsers": "playwright test --project=chromium --project=webkit --project=firefox",
    "test:safari": "npm run build && node --test --test-concurrency=1 scripts/test-safari.mjs",
    "dev": "tsup --watch",
    "demo": "vite --port 5174 --strictPort",
    "test:e2e": "npm run build && npm run test:e2e:browsers",
    "test:live": "npm run build && playwright test --project=live",
    "test:live:watch": "node scripts/live-watch.mjs"
  },
  "keywords": [
    "grovs",
    "javascript",
    "library",
    "deeplink",
    "attribution"
  ],
  "author": "Grovs",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2"
  }
}
