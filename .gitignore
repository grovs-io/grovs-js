node_modules/

# Build output. Generated by the bundler; what gets published is scoped by
# "files" in package.json, not by what happens to be committed.
#
# Note: dist/grovs.js and dist/html/messages_list.html are currently tracked,
# and listing them here does not untrack them — .gitignore only affects
# untracked files. The `git rm -r --cached dist` that finishes the job is a
# Phase 0 task (T14). Until then this pattern still earns its place: it keeps
# the new ESM/CJS/IIFE/.d.ts outputs from being added by accident.
dist/

.DS_Store
*.log

# Un-ignore docs/.
#
# A global excludesFile (~/.gitignore_global) ignores docs/ in every repository.
# For this project that would leave the v2 design spec under
# docs/superpowers/specs/ and the docs/CONTEXT.md required by the Release
# section outside version control entirely. A repository-local .gitignore takes
# precedence over the global one, so this negation restores them.
!docs/
