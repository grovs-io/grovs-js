node_modules/

# Build output. Generated by tsup; what gets published is scoped by
# "files" in package.json.
dist/

.DS_Store
*.log

# Un-ignore docs/.
#
# A global excludesFile (~/.gitignore_global) ignores docs/ in every repository.
# For this project that would leave the v2 design spec under
# docs/superpowers/specs/ and the docs/CONTEXT.md required by the Release
# section outside version control entirely. A repository-local .gitignore takes
# precedence over the global one, so this negation restores them.
!docs/

# Un-ignore src/storage/ and test/storage/.
#
# The same global excludesFile carries a bare `storage` pattern, which matches
# a directory of that name at ANY depth — so src/storage/ and test/storage/
# were silently never committed while existing locally. A fresh clone could
# not build: core/client.ts imports from ../storage/storage.
#
# Local test runs cannot catch this, because the files are present on the
# machine that wrote them. Only a clean checkout can.
!src/storage/
!test/storage/

# Generated by the test run.
coverage/
test-results/
playwright-report/
.gstack/
